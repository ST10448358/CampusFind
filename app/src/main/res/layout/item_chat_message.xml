<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingVertical="4dp">

        <!-- Bot Message Bubble -->
        <LinearLayout
            android:id="@+id/ll_bot_bubble"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:layout_marginEnd="48dp"
            android:background="@drawable/bg_rounded_pill"
            android:backgroundTint="#121B2D"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp">

            <TextView
                android:id="@+id/tv_bot_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bot response message here"
                android:textColor="#F9FAFB"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- User Message Bubble -->
        <LinearLayout
            android:id="@+id/ll_user_bubble"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginStart="48dp"
            android:background="@drawable/bg_rounded_pill"
            android:backgroundTint="#00A884"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_user_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="User message here"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />
        </LinearLayout>

    </LinearLayout>
</layout>
