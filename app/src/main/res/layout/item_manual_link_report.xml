<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="#101726"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:strokeColor="#1E2B42"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <!-- Checkbox -->
        <CheckBox
            android:id="@+id/cb_select_report"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:buttonTint="#00A884"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp" />

        <!-- Info Column -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Type Badge and Ref Code -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_type_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_rounded_pill"
                    android:backgroundTint="#3B1219"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:text="🔴 LOST"
                    android:textColor="#F87171"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_ref_code"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="REF-12345"
                    android:textColor="#6B7280"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Report Title -->
            <TextView
                android:id="@+id/tv_report_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Report Title"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Reporter & Location -->
            <TextView
                android:id="@+id/tv_report_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="John Doe • Main Library"
                android:textColor="#9CA3AF"
                android:textSize="12sp" />

        </LinearLayout>

        <!-- Eye Icon Button for Viewing Details -->
        <ImageButton
            android:id="@+id/btn_view_details"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="View Details"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_eye"
            app:tint="#9CA3AF" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>