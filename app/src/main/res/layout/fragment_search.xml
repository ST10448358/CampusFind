<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/color_background"
        android:orientation="vertical"
        android:paddingBottom="16dp"
        android:paddingHorizontal="16dp"
        android:paddingTop="42dp">

        <!-- Title Header -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/search_screen_title"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btn_filter_dialog"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentEnd="true"
                android:background="@drawable/bg_rounded_pill"
                android:backgroundTint="#0E1524"
                android:contentDescription="@string/get_started"
                android:padding="8dp"
                android:src="@drawable/ic_filter_sliders"
                app:tint="#00A884" />
        </RelativeLayout>

        <!-- Search Input -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_search_query"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/search_input_hint"
            app:boxBackgroundColor="#101726"
            app:boxCornerRadiusBottomEnd="14dp"
            app:boxCornerRadiusBottomStart="14dp"
            app:boxCornerRadiusTopEnd="14dp"
            app:boxCornerRadiusTopStart="14dp"
            app:boxStrokeColor="#1D2A3F"
            app:endIconDrawable="@android:drawable/ic_btn_speak_now"
            app:endIconMode="custom"
            app:endIconTint="#00A884"
            app:hintTextColor="#6B7280"
            app:startIconDrawable="@android:drawable/ic_menu_search"
            app:startIconTint="#9CA3AF">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_search_query"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#F9FAFB"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Type Filter Tabs (ALL / LOST / FOUND) -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabs_search_type"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_rounded_pill"
            android:backgroundTint="#0E1524"
            app:tabIndicatorColor="#00A884"
            app:tabIndicatorHeight="3dp"
            app:tabSelectedTextColor="#00A884"
            app:tabTextColor="#9CA3AF">

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tab_all" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tab_lost_items" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tab_found_items" />
        </com.google.android.material.tabs.TabLayout>

        <!-- Active Filter Indicator -->
        <TextView
            android:id="@+id/tv_active_filter_summary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Showing: All Categories • All Locations"
            android:textColor="#6B7280"
            android:textSize="12sp" />

        <!-- Recycler View -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_search_results"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="1" />

        <!-- Empty State -->
        <TextView
            android:id="@+id/tv_search_empty"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/search_empty"
            android:textColor="#9CA3AF"
            android:textSize="15sp"
            android:visibility="gone" />

    </LinearLayout>
</layout>
