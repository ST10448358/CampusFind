<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/color_background"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="96dp"
            android:paddingHorizontal="16dp"
            android:paddingTop="42dp">

            <!-- Admin Users Header Bar -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="User Directory"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CAMPUSFIND ADMIN"
                        android:textColor="#0EA5E9"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </RelativeLayout>

            <!-- Top Management Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:cardBackgroundColor="@color/color_surface"
                app:cardCornerRadius="20dp"
                app:strokeColor="#1A263B"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Campus User Management"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Review student and staff accounts, monitor report activity, and manage access authorizations."
                        android:textColor="#9CA3AF"
                        android:textSize="13sp" />

                    <!-- Search Input -->
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:hint="Search user name, email, ..."
                        app:boxBackgroundColor="#101726"
                        app:boxCornerRadiusBottomEnd="14dp"
                        app:boxCornerRadiusBottomStart="14dp"
                        app:boxCornerRadiusTopEnd="14dp"
                        app:boxCornerRadiusTopStart="14dp"
                        app:boxStrokeColor="#1D2A3F"
                        app:hintTextColor="#6B7280"
                        app:startIconDrawable="@android:drawable/ic_menu_search"
                        app:startIconTint="#9CA3AF">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_user_search"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="#F9FAFB"
                            android:textSize="14sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Role Filter Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="12dp"
                            android:text="Role:"
                            android:textColor="#9CA3AF"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <HorizontalScrollView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:scrollbars="none">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/chip_role_all"
                                    android:layout_width="wrap_content"
                                    android:layout_height="36dp"
                                    android:layout_marginEnd="8dp"
                                    android:text="All (3)"
                                    android:textColor="#FFFFFF"
                                    android:textSize="12sp"
                                    app:backgroundTint="#00A884"
                                    app:cornerRadius="10dp" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/chip_role_students"
                                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                    android:layout_width="wrap_content"
                                    android:layout_height="36dp"
                                    android:layout_marginEnd="8dp"
                                    android:text="Students (2)"
                                    android:textColor="#9CA3AF"
                                    android:textSize="12sp"
                                    app:backgroundTint="#101726"
                                    app:cornerRadius="10dp"
                                    app:strokeColor="#1F2D42" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/chip_role_admins"
                                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                    android:layout_width="wrap_content"
                                    android:layout_height="36dp"
                                    android:text="Admins (1)"
                                    android:textColor="#9CA3AF"
                                    android:textSize="12sp"
                                    app:backgroundTint="#101726"
                                    app:cornerRadius="10dp"
                                    app:strokeColor="#1F2D42" />
                            </LinearLayout>
                        </HorizontalScrollView>
                    </LinearLayout>

                    <!-- Status Filter Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:text="Status:"
                            android:textColor="#9CA3AF"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <HorizontalScrollView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:scrollbars="none">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/chip_status_all"
                                    android:layout_width="wrap_content"
                                    android:layout_height="36dp"
                                    android:layout_marginEnd="8dp"
                                    android:text="All Status"
                                    android:textColor="#FFFFFF"
                                    android:textSize="12sp"
                                    app:backgroundTint="#00A884"
                                    app:cornerRadius="10dp" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/chip_status_active"
                                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                    android:layout_width="wrap_content"
                                    android:layout_height="36dp"
                                    android:layout_marginEnd="8dp"
                                    android:text="Active (3)"
                                    android:textColor="#9CA3AF"
                                    android:textSize="12sp"
                                    app:backgroundTint="#101726"
                                    app:cornerRadius="10dp"
                                    app:strokeColor="#1F2D42" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/chip_status_deactivated"
                                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                    android:layout_width="wrap_content"
                                    android:layout_height="36dp"
                                    android:text="Deactivated (0)"
                                    android:textColor="#9CA3AF"
                                    android:textSize="12sp"
                                    app:backgroundTint="#101726"
                                    app:cornerRadius="10dp"
                                    app:strokeColor="#1F2D42" />
                            </LinearLayout>
                        </HorizontalScrollView>
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- User Directory Table Card Container -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="24dp"
                app:cardBackgroundColor="@color/color_surface"
                app:cardCornerRadius="20dp"
                app:strokeColor="#1A263B"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:text="Registered Users Directory"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <!-- Recycler View List -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_admin_users"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false" />

                    <!-- Empty State -->
                    <TextView
                        android:id="@+id/tv_admin_users_empty"
                        android:layout_width="match_parent"
                        android:layout_height="160dp"
                        android:gravity="center"
                        android:text="No users found."
                        android:textColor="#9CA3AF"
                        android:textSize="14sp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>
</layout>
